# 데이터베이스 (docker-compose 기본값과 일치)
DATABASE_URL=postgresql+psycopg://codetrace:codetrace@localhost:5432/codetrace

# CORS 허용 (콤마 구분: 로컬 + 배포 도메인)
# 프리뷰 배포는 주소가 매번 바뀌므로 CORS_ORIGIN_REGEX가 따로 허용한다.
# 기본값이 코드에 있으니 비워두지 말 것 (빈 값으로 두면 프리뷰가 차단된다).
CORS_ORIGINS=http://localhost:5173

# JWT 서명 키 (32자 이상 권장. 배포 환경에서는 자동 생성값을 쓴다)
SECRET_KEY=local-development-secret-key-change-in-production

# LLM (모든 호출은 src/llm 경유, provider 교체 가능)
# API 키는 반드시 팀 Organization에서 발급할 것 (개인 계정 키를 쓰면 팀 크레딧이 아닌 개인 요금으로 청구됨)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_ORG_ID=
LLM_MODEL=

# GitHub App (데이터 담당 작업 시 채움)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
