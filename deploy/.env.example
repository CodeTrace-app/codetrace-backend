# 서버에 deploy/.env 로 복사해 채운다. 이 파일은 커밋하지 않는다.

# 인증서를 받을 주소. 도메인이 없으면 sslip.io 를 쓴다 (공인 IP의 점을 하이픈으로).
#   예) 203-0-113-5.sslip.io
DOMAIN=

# DB 비밀번호. 아무 긴 문자열이면 된다. 서버 밖으로 열지 않는다.
POSTGRES_PASSWORD=

# 토큰 서명 키. 바뀌면 기존 로그인 세션이 전부 끊긴다.
SECRET_KEY=

CORS_ORIGINS=https://codetrace-frontend.vercel.app
FRONTEND_URL=https://codetrace-frontend.vercel.app

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_ORG_ID=
LLM_MODEL=

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

DEMO_REPO=acme-payments/acme-payment-service
DEMO_INSTALLATION_ID=
